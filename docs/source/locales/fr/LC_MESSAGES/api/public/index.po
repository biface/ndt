msgid "Public API Reference"
msgstr "Référence de l’API publique"

msgid ""
"This section documents all classes and exceptions that are part of the "
"stable public API of **ndict-tools**. Everything listed here is exported "
"from the top-level ``ndict_tools`` package and covered by the project's "
"stability guarantees."
msgstr ""
"Cette section documente toutes les classes et exceptions qui font partie "
"de l’API publique stable de **ndict-tools**. Tout ce qui figure ici est "
"exporté par le paquet de premier niveau ``ndict_tools`` et couvert par "
"les garanties de stabilité du projet."

msgid ""
"from ndict_tools import NestedDictionary, PathsView, CompactPathsView\n"
"from ndict_tools import StackedDictionaryError  # and subclasses"
msgstr ""
"from ndict_tools import NestedDictionary, PathsView, CompactPathsView\n"
"from ndict_tools import StackedDictionaryError  # et ses sous-classes"

