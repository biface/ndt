msgid "Deprecation Notices"
msgstr "Avis de dépréciation"

msgid "This page tracks all active and resolved deprecations in **ndict-tools**."
msgstr ""
"Cette page recense toutes les dépréciations, en cours et résolues, de "
"**ndict-tools**."

msgid "Symbol"
msgstr "Symbole"

msgid "Deprecated in"
msgstr "Déprécié en"

msgid "Removed in"
msgstr "Supprimé en"

msgid "Migration"
msgstr "Migration"

